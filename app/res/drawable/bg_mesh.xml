<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="300dp"
                android:centerX="0.95" android:centerY="0.0"
                android:startColor="#8C7C6CFF" android:endColor="#007C6CFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="290dp"
                android:centerX="-0.05" android:centerY="0.75"
                android:startColor="#5C5AD8E6" android:endColor="#005AD8E6"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="180dp"
                android:centerX="0.92" android:centerY="0.88"
                android:startColor="#5C7C6CFF" android:endColor="#007C6CFF"/>
        </shape>
    </item>
</layer-list>
