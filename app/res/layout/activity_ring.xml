<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_mesh"/>

    <View
        android:id="@+id/pulse1"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pulse"/>

    <View
        android:id="@+id/pulse2"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pulse"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/ring_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="86sp"
            android:fontFamily="sans-serif-thin"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/ring_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11月4日 星期三"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF"/>

        <TextView
            android:id="@+id/ring_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_msg_pill"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="闹钟"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxWidth="320dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_chip"
            android:gravity="center"
            android:text="贪睡 5 分钟"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_cta"
            android:gravity="center"
            android:text="停止"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cta_text"/>
    </LinearLayout>
</FrameLayout>
