<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/pulse1"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pulse"/>

    <View
        android:id="@+id/pulse2"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pulse"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/ring_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="92sp"
            android:fontFamily="sans-serif-thin"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/ring_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11月4日 星期三"
            android:textSize="14sp"
            android:textColor="#99FFFFFF"/>

        <TextView
            android:id="@+id/ring_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_msg_pill"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="闹钟"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <TextView
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_ghost"
            android:gravity="center"
            android:text="贪睡 5 分钟"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_pill_primary"
            android:gravity="center"
            android:text="停止"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</FrameLayout>
